  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": ".test-build",
    "rootDir": "src/data",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
